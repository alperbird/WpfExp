<Window x:Class="WpfExp.LoginPage.LoginPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfExp.LoginPage"
        mc:Ignorable="d"
        Title="LoginPage" Height="450" Width="800">
    <Grid Background="Azure">
        <Grid.RowDefinitions>
            <RowDefinition Height="1*" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Kullanıcı Girişi" 
                   FontSize="24" FontWeight="Bold" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <StackPanel Grid.Row="1" Margin="20">
            <Label Content="Kullanıcı Adı:" FontWeight="Bold" />
            <TextBox x:Name="txtUserName" Margin="0,5,0,15" />

            <Label Content="Şifre:" FontWeight="Bold" />
            <PasswordBox x:Name="pssbowPassword" Margin="0,5,0,15" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Giriş Yap" Width="100" Margin="5" Click="LoginButton_Click" />
                <Button Content="İptal" Width="100" Margin="5" />
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="ErrorTextBlock" Grid.Row="2" Foreground="Red" 
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

        <Image Grid.Row="2" HorizontalAlignment="Left" VerticalAlignment="Center"  
               Width="364" Height="100" Margin="213,0,0,0">
            <Image.Source>
                <BitmapImage UriSource="WpfExp;component/Images/yatıklogo.png"/>
            </Image.Source>
        </Image>

    </Grid>
</Window>
