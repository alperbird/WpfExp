<Window x:Class="WpfExp.CRUDWindowCustomer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteri CRUD Penceresi" Height="480" Width="1000">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Sol -->
            <ColumnDefinition Width="5"/>
            <!-- Splitter -->
            <ColumnDefinition Width="3*"/>
            <!-- Sağ -->
        </Grid.ColumnDefinitions>

        <!-- Sol (Form) -->
        <ScrollViewer Grid.Column="0" Margin="10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Grid.Column="0" Margin="10" VerticalAlignment="Top">
                <TextBlock Text="Müşteri Adı:"/>
                <TextBox x:Name="txtName" Width="200" Margin="0,0,0,10"/>

                <TextBlock Text="Açıklama:"/>
                <TextBox x:Name="txtDesc" Width="200" Margin="0,0,0,10"/>

                <TextBlock Text="Ülke:"/>
                <ComboBox x:Name="cmbCountry" Width="200" SelectionChanged="cmbCountry_SelectionChanged" DisplayMemberPath="name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                <TextBlock Text="Şehir:"/>
                <ComboBox x:Name="cmbCity" Width="200" DisplayMemberPath="name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                <TextBlock Text="Makineler:"/>
                <ListBox x:Name="lstMachine" Width="200" Height="100" SelectionMode="Single" DisplayMemberPath="name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                <TextBlock Text="Markalar:"/>
                <ListBox x:Name="lstpBrand" Width="200" Height="100" SelectionMode="Single" DisplayMemberPath="name" SelectedValuePath="Id" Margin="0,0,0,10" 
             SelectionChanged="lstpBrand_SelectionChanged"/>

                <TextBlock Text="Profil Serileri:"/>
                <ListBox x:Name="lstpSeries" Width="200" Height="100" SelectionMode="Single" DisplayMemberPath="name" SelectedValuePath="Id" Margin="0,0,0,10"
                         SelectionChanged="lstpSeries_SelectionChanged"/>

                <TextBlock Text="Profil Örnekleri:"/>
                <ListBox x:Name="lstpexm" Width="200" Height="100" SelectionMode="Multiple" DisplayMemberPath="name" SelectedValuePath="Id" Margin="0,0,0,10"/>

                <TextBlock Text="Seri Numarası:"/>
                <TextBox x:Name="txtSerieNumber" Width="200" Margin="0,0,0,10"/>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Ekle" Width="100" Click="insertBtn"/>
                    <Button Content="Güncelle" Width="100" Margin="10,0,0,0" Click="updateBtn"/>
                    <Button Content="Sil" Width="100" Margin="10,0,0,0" Click="deleteBtn"/>
                </StackPanel>
            </StackPanel>

        </ScrollViewer>
        
        <!-- Sağ (DataGrid) -->
        <Grid Grid.Column="2" Margin="10">
            <DataGrid x:Name="dgCustomers" AutoGenerateColumns="True" IsReadOnly="True" SelectionChanged="dgCustomer">
            </DataGrid>
        </Grid>
    </Grid>
</Window>
