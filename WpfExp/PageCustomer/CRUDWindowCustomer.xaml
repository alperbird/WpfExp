<Window x:Class="WpfExp.CRUDWindowCustomer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Müşteri CRUD Penceresi" Height="450" Width="947">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Sol -->
            <ColumnDefinition Width="5"/>
            <!-- Splitter -->
            <ColumnDefinition Width="3*"/>
            <!-- Sağ -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- İçerik -->
            <RowDefinition Height="Auto"/>
            <!-- Alt Butonlar -->
        </Grid.RowDefinitions>

        <!-- Sol Taraf (Form) -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- Esnek Form Alanı -->
                <RowDefinition Height="Auto"/>
                <!-- Alt Buton -->
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled" 
                          Grid.Row="0"
                          Background="Azure">
                <UniformGrid Columns="2" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <!-- Sol Alan -->
                    <Label Content="Müşteri Adı:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtName" Margin="5" MinWidth="150"/>

                    <Label Content="Açıklama:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtDesc" Margin="5" MinWidth="150"/>

                    <Label Content="Ülke:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="cmbCountry" Margin="5" MinWidth="150"
                              DisplayMemberPath="name" SelectedValuePath="CountriesID"/>

                    <Label Content="Şehir:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="cmbCity" Margin="5" MinWidth="150"
                              DisplayMemberPath="name" SelectedValuePath="CitiesID"/>

                    <Label Content="Makine:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="cmbMachine" Margin="5" MinWidth="150"
                              DisplayMemberPath="name" SelectedValuePath="machID"/>

                    <Label Content="Profil Markası:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="cmbProfileBrand" Margin="5" MinWidth="150"
                              DisplayMemberPath="name" SelectedValuePath="ProfileID"/>

                    <Label Content="Profil Serisi:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="cmbProfileSeries" Margin="5" MinWidth="150"
                              DisplayMemberPath="name" SelectedValuePath="SeriesID"/>

                    <Label Content="Profil Örneği:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtProfileExample" Margin="5" MinWidth="150"/>
                </UniformGrid>
            </ScrollViewer>

            <!-- Alt Buton -->
            <Button Content="Ekle" HorizontalAlignment="Center" 
                    Width="100" Height="30" Margin="0,374,0,10" Click="insertButton" Grid.RowSpan="2"/>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                      ResizeBehavior="PreviousAndNext" Background="Gray"/>

        <!-- Sağ Taraf (DataGrid) -->
        <Grid Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Alt Butonlar -->
            </Grid.RowDefinitions>

            <!-- DataGrid -->
            <DataGrid 
                Grid.Row="0" 
                x:Name="dgCustomers"
                ColumnWidth="*"
                IsReadOnly="True"
                AutoGenerateColumns="True" 
                Margin="5" 
                SelectionChanged="dgCustomer">
            </DataGrid>

            <!-- Alt Butonlar -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="5">
                <Button Content="Güncelle" Width="100" Height="30" Margin="5" Click="updateBtn"/>
                <Button Content="Sil" Width="100" Height="30" Margin="5" Click="deleteBtn"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
