<Window x:Class="WpfExp.PageCity.CRUDWindowCity"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfExp.PageCity"
        mc:Ignorable="d"
        Title="Şehir CRUD Penceresi" Height="450" Width="800">
    <Grid Margin="10" Background="Azure">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sol Tarafta Ekleme Formu -->
        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Top" Margin="5,94,5,0" Grid.RowSpan="2">
            <!-- Şehir Adı -->
            <Label Content="Şehir Adı:" Margin="5,0,5,0" Width="60"/>
            <TextBox Name="txtCityName" Margin="5,0,5,10" Width="200"/>

            <!-- Şehir Açıklaması -->
            <Label Content="Açıklama:" Margin="5,10,5,0" Width="60"/>
            <TextBox Name="txtCityDesc" Margin="5,0,5,10" Width="200"/>

            <!-- Ülke Seçimi -->
            <Label Content="Ülke:" Margin="5,10,5,0" Width="60"/>
            <ComboBox Name="cmbCountry" Margin="5,0,5,10" Width="200"
                      SelectedValuePath="CountriesID"
                      DisplayMemberPath="name"/>

            <!-- İşlem Butonları -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button Content="Ekle" Width="75" Margin="5" Click="insertBtn"/>
                <Button Content="Güncelle" Width="75" Margin="5" Click="updateBtn"/>
                <Button Content="Sil" Width="75" Margin="5" Click="deleteBtn"/>
            </StackPanel>
        </StackPanel>

        <!-- Sağ Tarafta DataGrid (Tablo) -->
        <DataGrid Grid.Row="1" Grid.Column="1" x:Name="dgCities"
                  ColumnWidth="*"
                  IsReadOnly="True"
                  AutoGenerateColumns="True" 
                  CanUserAddRows="False" 
                  Margin="5"
                  HorizontalAlignment="Stretch" 
                  VerticalAlignment="Stretch" 
                  Height="Auto" SelectionChanged="dgCity">

        </DataGrid>
    </Grid>
</Window>
