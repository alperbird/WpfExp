<Window x:Class="WpfExp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfExp"
        mc:Ignorable="d"
        Title="Maraba Dünya" Height="400" Width="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ComboBox Name="ulkeler" Margin="114,40,419,157" SelectionChanged="countries_SelectionChanged">
            <ComboBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-360.37"/>
                    <TranslateTransform/>
                </TransformGroup>
            </ComboBox.RenderTransform>
        </ComboBox>
        <TextBox HorizontalAlignment="Left" Margin="53,43,0,0" TextWrapping="Wrap" Text="Ülkeler:" VerticalAlignment="Top" Width="50" Height="16"/>
        <Label Content="Şehirler:" HorizontalAlignment="Left" Margin="362,35,0,0" VerticalAlignment="Top" Width="61" Height="24"/>
        <ComboBox Name="sehirler" Margin="432,40,101,157">
            <ComboBox.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-360.37"/>
                    <TranslateTransform/>
                </TransformGroup>
            </ComboBox.RenderTransform>
        </ComboBox>
        <Label Content="Müşteri: " HorizontalAlignment="Left" Margin="53,109,0,0" VerticalAlignment="Top" Width="50"/>
    </Grid>

</Window>
