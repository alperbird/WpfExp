<Window x:Class="WpfExp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WpfExp.MainPage"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Closed="ClosedWindow"
        Title="Machines Detail" Height="500" Width="800">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Üstteki filtreler -->
            <RowDefinition Height="*"/>
            <!-- DataGrid alanı -->
        </Grid.RowDefinitions>

        <!-- Üst Filtreler -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Left">
            <Label Content="Ülkeler" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="ulkeler"
                      Width="150"
                      IsTextSearchEnabled="True"
                      SelectionChanged="countries_SelectionChanged"
                      Margin="0,0,15,0"/>

            <Label Content="Şehirler" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="sehirler"
                      Width="150"
                      SelectionChanged="sehirler_SelectionChanged"
                      Margin="0,0,15,0"/>

            <Label Content="Müşteri" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="musteri" 
                      DisplayMemberPath="name" 
                      SelectedValuePath="CustomerID" 
                      Width="150" 
                      SelectionChanged="musteri_SelectionChanged" 
                      Margin="0,0,15,0"/>
        </StackPanel>

        <!-- DataGrid -->
        <DataGrid x:Name="dgMakina"
                  Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  IsReadOnly="True"
                  LoadingRowDetails="DataGrid_LoadingRowDetails"
                  RowDetailsVisibilityMode="VisibleWhenSelected">
            <DataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="Profil Markaları :" FontWeight="Bold" Margin="0,10,0,0"/>
                        <DataGrid CanUserAddRows="False" AutoGenerateColumns="True" ItemsSource="{Binding DetailBrands}" Height="100" IsReadOnly="True"/>

                        <TextBlock Text="Profil Serileri :" FontWeight="Bold" Margin="0,10,0,0"/>
                        <DataGrid CanUserAddRows="False" AutoGenerateColumns="True" ItemsSource="{Binding DetailSeries}" Height="100" IsReadOnly="True"/>

                        <TextBlock Text="Profil Örnekleri :" FontWeight="Bold" Margin="0,10,0,0"/>
                        <DataGrid CanUserAddRows="False" AutoGenerateColumns="False" ItemsSource="{Binding DetailExamples}" Height="150" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="100" />
                                <DataGridTextColumn Header="Dosya Adı" Binding="{Binding filetype}" Width="200" />
                                <DataGridTextColumn Header="Boyut (KB)" Binding="{Binding ContentSize}" Width="200" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Dosyayı Aç" 
                                Click="OpenFileButton_Click" 
                                Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                Tag="1008" 
                                Margin="5" />



                    </StackPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>


            <DataGrid.Columns>
                <DataGridTextColumn Header="Makine Adı" Binding="{Binding Path=MachineName}" Width="*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Açıklama" Binding="{Binding Path=description}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Müşteri ID" Binding="{Binding Path=CustomerId}" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Header="Seri No" Binding="{Binding Path=SerialNumber}" Width="100" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button Content="Buton Sayfası" HorizontalAlignment="Left" Margin="688,6,0,0" VerticalAlignment="Top" Width="77" Click="Button_Click"/>
    </Grid>
</Window>