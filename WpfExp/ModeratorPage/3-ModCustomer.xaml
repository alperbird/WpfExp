<Window x:Class="WpfExp.ModeratorPage._3_ModCustomer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfExp.ModeratorPage"
        mc:Ignorable="d"
        Title="_3_ModCustomer" Height="455" Width="900">
    <Grid Background="Azure">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Sol -->
            <ColumnDefinition Width="5"/>
            <!-- Splitter -->
            <ColumnDefinition Width="3*"/>
            <!-- Sağ -->
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- İçerik -->
            <RowDefinition Height="Auto"/>
            <!-- Alt Butonlar -->
        </Grid.RowDefinitions>

        <!-- Sol Taraf (Form) -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- Esnek Form Alanı -->
                <RowDefinition Height="Auto"/>
                <!-- Alt Buton -->
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled" 
                      Grid.Row="0"
                      Background="Azure">
                <UniformGrid Columns="2" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <!-- Sol Alan -->
                    <Label Content="Müşteri Adı:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtName" Margin="5" Width="150" Height="30"/>

                    <Label Content="Açıklama:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtDesc" Margin="5" Width="150" Height="30"/>

                    <Label Content="Ülke:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="cmbCountry" Margin="5" Width="150" Height="30"
                          DisplayMemberPath="name" SelectedValuePath="Id" SelectionChanged="cmbCountry_SelectionChanged"/>

                    <Label Content="Şehir:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="cmbCity" Margin="5" Width="150" Height="30"
                          DisplayMemberPath="name" SelectedValuePath="Id" />

                    <Label Content="Makine:" VerticalAlignment="Center" Margin="5"/>
                    <ListBox x:Name="lstMachine" Margin="5" Width="150" Height="50"
                          DisplayMemberPath="name" SelectedValuePath="Id" SelectionMode="Multiple"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"/>


                    <Label Content="Profil Markası:" VerticalAlignment="Center" Margin="5"/>
                    <ListBox x:Name="cmbProfileBrand" Margin="5" Width="150" Height="30" 
                          DisplayMemberPath="name" SelectedValuePath="Id" SelectionChanged="cmbProfileBrand_SelectionChanged" SelectionMode="Multiple"/>

                    <Label Content="Profil Serisi:" VerticalAlignment="Center" Margin="5"/>
                    <ListBox x:Name="cmbProfileSeries" Margin="5" Width="150" Height="30"
                          DisplayMemberPath="name" SelectedValuePath="Id" SelectionMode="Multiple"
                         ScrollViewer.VerticalScrollBarVisibility="Visible"/>

                    <Label Content="Profil Örneği:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtProfileExample" Margin="5" Width="150" Height="30"/>

                    <Label Content="Seri No: " VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="txtSerieNumber" Margin="5" Width="150" Height="30"/>
                </UniformGrid>
            </ScrollViewer>

            <!-- Alt Buton -->
            <Button Content="Ekle" HorizontalAlignment="Center" 
                Width="100" Height="30" Margin="0,374,0,10" Click="insertButton" Grid.RowSpan="2"/>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                  ResizeBehavior="PreviousAndNext" Background="Gray"/>

        <!-- Sağ Taraf (DataGrid) -->
        <Grid Grid.Column="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Alt Butonlar -->
            </Grid.RowDefinitions>

            <!-- DataGrid -->
            <DataGrid 
            Grid.Row="0" 
            x:Name="dgCustomers"
            ColumnWidth="*"
            IsReadOnly="True"
            AutoGenerateColumns="True" 
            Margin="5">
            </DataGrid>
        </Grid>
    </Grid>
</Window>
