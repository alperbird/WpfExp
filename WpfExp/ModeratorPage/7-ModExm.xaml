<Window x:Class="WpfExp.ModeratorPage._7_ModExm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfExp.ModeratorPage"
        mc:Ignorable="d"
        Title="_7_ModExm" Height="450" Width="1000">
    <Grid Background="Azure">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
            <Label Content="Örnek Adı:" Margin="5,0,5,0" Width="75" />
            <TextBox Name="txtExmName" Margin="5,0,5,10" Width="200"/>

            <Label Content="Açıklama:" Margin="5,0,5,0" Width="75"/>
            <TextBox Name="txtExmDesc" Margin="5,0,5,10" Width="200"/>

            <Label Content="Dosya Yükleme:" Margin="5,0,5,5" Width="96"/>

            <!-- Dosya seçme ve listeleme alanı -->
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <ListBox Name="lstFiles" Height="100" Margin="5" Grid.Column="0" SelectionMode="Single"/>
                <StackPanel Orientation="Vertical" Grid.Column="1" Margin="5,0,0,0">
                    <Button Content="Dosya Ekle" Width="100" Margin="0,5,0,5" Click="addFileBtn"/>
                    <Button Content="Seçili Dosyayı Sil" Width="100" Margin="0,5,0,5" Click="removeFileBtn"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button Content="Ekle" Width="75" Margin="5" Click="insertBtn"/>
            </StackPanel>
        </StackPanel>

        <DataGrid Grid.Row="1" Grid.Column="1" x:Name="dgExamples"
          ColumnWidth="*"
          IsReadOnly="True"
          AutoGenerateColumns="True" 
          CanUserAddRows="False" 
          Margin="5,0,5,5" 
          HorizontalAlignment="Stretch" 
          VerticalAlignment="Stretch" 
          Height="Auto"/>
    </Grid>
</Window>
