<Window x:Class="WpfExp.PageExample.CRUDWindowProfieExample"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfExp.PageExample"
        mc:Ignorable="d"
        Title="CRUDWindowProfieExample" Height="450" Width="1130">
    <Grid Background="Azure">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Üstteki alan -->
            <RowDefinition Height="*" />
            <!-- Alt alan -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <!-- Sol alan -->
            <ColumnDefinition Width="3*" />
            <!-- Sağ alan -->
        </Grid.ColumnDefinitions>

        <!-- Sol Panel -->
        <StackPanel Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="10">
            <!-- Örnek Bilgileri -->
            <Label Content="Örnek Adı:" Margin="5,0,5,0" />
            <TextBox Name="txtExmName" Margin="5,0,5,10" Width="200" />

            <Label Content="Açıklama:" Margin="5,0,5,0" />
            <TextBox Name="txtExmDesc" Margin="5,0,5,10" Width="200" />

            <!-- Dosya Yükleme -->
            <Label Content="Dosya Yükleme:" Margin="5,0,5,5" />
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <ListBox Name="lstFiles" Height="100" Margin="5" Grid.Column="0" SelectionMode="Single" />
                <StackPanel Orientation="Vertical" Grid.Column="1" Margin="5,0,0,0">
                    <Button Content="Dosya Ekle" Width="100" Margin="0,5,0,5" Click="addFileBtn" />
                    <Button Content="Seçili Dosyayı Sil" Width="100" Margin="0,5,0,5" Click="removeFileBtn" />
                    <Button Content="Tüm Dosyaları Sil" Width="100" Margin="0,5,0,5" Click="clearAllFilesBtn" />
                </StackPanel>
            </Grid>

            <!-- İşlem Butonları -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <Button Content="Ekle" Width="75" Margin="5" Click="insertBtn" />
                <Button Content="Güncelle" Width="75" Margin="5" Click="updateBtn" />
                <Button Content="Sil" Width="75" Margin="5" Click="deleteBtn" />
            </StackPanel>
        </StackPanel>

        <!-- Sağ Panel -->
        <DataGrid Grid.Row="1" Grid.Column="1" x:Name="dgExamples"
                  AutoGenerateColumns="True"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  ColumnWidth="*"
                  Margin="10"
                  SelectionChanged="dgExample" />
    </Grid>
</Window>
